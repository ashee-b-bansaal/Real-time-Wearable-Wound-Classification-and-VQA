{
  "version": 1,
  "image_size": 224,
  "preprocess": {
    "input_format": "CHW_RGB_float32",
    "normalize_mean": [0.485, 0.456, 0.406],
    "normalize_std": [0.229, 0.224, 0.225]
  },
  "stage1": {
    "classes": ["not_wound", "wound"],
    "threshold": 0.45
  },
  "stage2": {
    "heads_order": [
      "anatomic_locations",
      "wound_type",
      "wound_thickness",
      "tissue_color",
      "drainage_amount",
      "drainage_type",
      "infection"
    ],
    "id_to_label": {}
  },
  "temporal": {
    "stable_frames_required": 6,
    "clear_metadata_after_non_wound_frames": 5
  },
  "nebulon": {
    "optional_remote": true,
    "delay_sec": 2.0
  }
}

